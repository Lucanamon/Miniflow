{
  "name": "miniflow",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "npm run dev",
    "dev": "concurrently \"npm run start:backend\" \"npm run start:frontend\"",
    "dev:watch": "concurrently \"npm run watch:backend\" \"npm run start:frontend\"",
    "start:frontend": "cross-env NODE_TLS_REJECT_UNAUTHORIZED=0 ng serve frontend",
    "start:backend": "dotnet run --project backend/Miniflow.Backend.csproj",
    "build": "ng build frontend",
    "build:frontend": "ng build frontend",
    "build:frontend:prod": "ng build frontend --configuration production",
    "build:backend": "dotnet build backend/Miniflow.Backend.csproj",
    "watch": "ng build frontend --watch --configuration development",
    "watch:backend": "dotnet watch run --project backend/Miniflow.Backend.csproj",
    "test": "ng test",
    "test:frontend": "ng test frontend",
    "test:backend": "dotnet test backend/Miniflow.Backend.csproj",
    "serve:ssr:frontend": "node dist/frontend/server/server.mjs"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "packageManager": "npm@11.6.2",
  "dependencies": {
    "@angular/common": "^21.1.0",
    "@angular/compiler": "^21.1.0",
    "@angular/core": "^21.1.0",
    "@angular/forms": "^21.1.0",
    "@angular/platform-browser": "^21.1.0",
    "@angular/platform-server": "^21.1.0",
    "@angular/router": "^21.1.0",
    "@angular/ssr": "^21.1.1",
    "express": "^5.1.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.1.1",
    "@angular/cli": "^21.1.1",
    "@angular/compiler-cli": "^21.1.0",
    "@tailwindcss/postcss": "^4.1.18",
    "@types/express": "^5.0.1",
    "@types/node": "^20.17.19",
    "autoprefixer": "^10.4.23",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "jsdom": "^27.1.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.18",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8"
  }
}
