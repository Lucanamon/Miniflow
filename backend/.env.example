PORT=55598
NODE_ENV=development

# Prisma Database URL (for Prisma ORM)
# Local development:
DATABASE_URL="postgresql://miniflow:miniflowpass@localhost:5432/miniflowdb?schema=public"
# Production example:
# DATABASE_URL="postgresql://user:password@your-db-host:5432/dbname?schema=public"

# Backend Base URL (for logging, optional)
BASE_URL=http://localhost:55598
# Production example:
# BASE_URL=https://api.mybackend.com

# JWT Secret (if using authentication)
JWT_SECRET=your-secret-key-change-in-production

# PostgreSQL Docker Configuration (for legacy TypeORM if needed)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=miniflow
DB_PASSWORD=miniflowpass
DB_DATABASE=miniflowdb
